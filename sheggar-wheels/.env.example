# Copy to .env.local and fill in.
# 32+ random chars, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BETTER_AUTH_SECRET=

# Public origin of the app (used for cookies and CSRF origin checks).
BETTER_AUTH_URL=http://localhost:3000

# Optional comma-separated extra allowed origins (e.g. a preview URL).
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional: API key for the hosted Better Auth dashboard (dash.better-auth.com).
# Create one at https://dash.better-auth.com, then paste it here to let the
# `dash()` plugin in src/lib/auth.ts send events and directory data.
# Leave blank to keep the hosted dashboard disconnected; sign-in still works.
BETTER_AUTH_API_KEY=
